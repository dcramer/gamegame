# ==============================================================================
# Dependencies
# ==============================================================================

# Node.js dependencies installed via pnpm/npm/yarn
node_modules/


# ==============================================================================
# Cloudflare Workers
# ==============================================================================

# Wrangler local development state (local D1, KV, R2, Queue bindings)
# Contains temporary files, local database, and cache
.wrangler/

# Local environment variables (contains API keys and secrets)
# Never commit - use Wrangler secrets for production
.dev.vars

# Local Wrangler configuration overrides
# Used for local-specific settings that shouldn't be in version control
wrangler.toml.local


# ==============================================================================
# Build Outputs
# ==============================================================================

# Wrangler build output (server-side worker bundle)
dist/

# React Router build output (SSR pages and server build)
build/

# Vite build output for React chat widget
# These are generated from client/ source and served as static assets
public/*.js
public/*.js.map
public/*.css
public/*.css.map


# ==============================================================================
# Environment & Secrets
# ==============================================================================

# Environment variable files (may contain secrets)
.env
.env.local
.env.*.local


# ==============================================================================
# Testing
# ==============================================================================

# Vitest coverage reports
coverage/
.vitest/


# ==============================================================================
# TypeScript
# ==============================================================================

# TypeScript build info cache
*.tsbuildinfo


# ==============================================================================
# Logs & Debug
# ==============================================================================

# All log files (Wrangler, npm, application logs)
*.log
logs/
npm-debug.log*
pnpm-debug.log*


# ==============================================================================
# Editor & OS
# ==============================================================================

# macOS Finder metadata
.DS_Store

# VS Code workspace settings (optional - remove if you want to share)
.vscode/settings.json

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/


# ==============================================================================
# Temporary & Cache
# ==============================================================================

# Temporary files
*.tmp
*.temp
.cache/

