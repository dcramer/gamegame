{
  "name": "gamegame-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"wrangler dev --config wrangler.dev.toml\" \"react-router dev\"",
    "build": "react-router build",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "setup": "pnpm db:migrate:local",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply gamegame --local",
    "db:migrate:remote": "wrangler d1 migrations apply gamegame --remote",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node scripts/reset-local-db.js",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "cli": "tsx cli.ts",
    "generate:favicon": "tsx scripts/generate-favicon.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.53",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@hono/node-server": "^1.19.5",
    "@hono/zod-validator": "^0.7.4",
    "@mistralai/mistralai": "^1.10.0",
    "@openai/agents": "^0.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/cloudflare": "^10.22.0",
    "ai": "^5.0.79",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "fast-xml-parser": "^5.3.0",
    "hono": "^4.10.3",
    "isbot": "^5.1.31",
    "lucide-react": "^0.545.0",
    "mime": "^4.1.0",
    "nanoid": "^5.1.6",
    "partial-json": "^0.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.4",
    "react-router-dom": "^7.9.4",
    "resend": "^6.2.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ai-sdk/react": "^2.0.79",
    "@cloudflare/kv-asset-handler": "^0.4.0",
    "@cloudflare/vite-plugin": "^1.13.15",
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "@react-router/cloudflare": "^7.9.4",
    "@react-router/dev": "^7.9.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
