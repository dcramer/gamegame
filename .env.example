DATABASE_URL=postgres://postgres:postgres@localhost:5433/gamegame
OPENAI_API_KEY=

# Email is handled via Resend, which is needed for auth
AUTH_RESEND_KEY=

# Added via npx auth. Read more: https://cli.authjs.dev
AUTH_SECRET=

# Public URL of your app (for CORS and other features)
# Development: http://localhost:3000
# Production: https://gamegame.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# If you want to enforce rate limits, configure Vercel KV:
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# If you don't configure Vercel Blob, uploads will be stored in ./public/uploads
BLOB_READ_WRITE_TOKEN=

# PDF extractor to use: "mistral"
DEFAULT_PDF_EXTRACTOR=mistral

# If using mistral (recommended for better quality and speed)
MISTRAL_API_KEY=

# Vercel Cron authentication (required for scheduled jobs in production)
# Generate a random secret: openssl rand -base64 32
# Only needed in production - set in Vercel environment variables dashboard
CRON_SECRET=

# Sentry error tracking (optional - only for production)
# Leave unset in development to use Spotlight (local debugging UI at localhost:8969)
# Production DSN: https://491514b0beea2842d2bc10d78053fb4e@o172566.ingest.us.sentry.io/4507903928238080
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
